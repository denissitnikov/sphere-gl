{
  "name": "sphere-gl",
  "version": "1.4.2",
  "description": "WebGL2 and OKLCH background and 5K wallpaper generator. Zero runtime dependencies, 0% idle GPU.",
  "type": "module",
  "main": "./dist/sphere-gl.min.js",
  "module": "./dist/sphere-gl.esm.min.js",
  "exports": {
    ".": {
      "import": "./dist/sphere-gl.esm.min.js",
      "default": "./src/index.js"
    },
    "./react": {
      "import": "./dist/sphere-gl.react.js",
      "default": "./src/react.js"
    },
    "./framer": {
      "import": "./dist/sphere-gl.framer.js",
      "default": "./src/framer.js"
    },
    "./src/*": "./src/*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "sideEffects": [
    "./dist/sphere-gl.min.js",
    "./src/browser.js"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "webgl2",
    "glsl",
    "gradient",
    "mesh-gradient",
    "sphere-gradient",
    "oklch",
    "oklab",
    "background",
    "wallpaper",
    "solar-clock",
    "framer",
    "react",
    "procedural",
    "shader"
  ],
  "author": "Denis S. (https://github.com/denissitnikov)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denissitnikov/sphere-gl.git"
  },
  "bugs": {
    "url": "https://github.com/denissitnikov/sphere-gl/issues"
  },
  "homepage": "https://denissitnikov.github.io/sphere-gl/"
}
