{
  "name": "sphere-gl",
  "version": "1.5.1",
  "description": "WebGL2 and OKLCH/Display-P3 background and 5K wallpaper engine. Zero runtime dependencies, 0% idle GPU.",
  "type": "module",
  "main": "./dist/sphere-gl.esm.min.js",
  "module": "./dist/sphere-gl.esm.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/sphere-gl.esm.min.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/sphere-gl.react.js",
      "default": "./src/react.js"
    },
    "./framer": {
      "types": "./types/framer.d.ts",
      "import": "./dist/sphere-gl.framer.js",
      "default": "./src/framer.js"
    },
    "./export": {
      "types": "./types/export.d.ts",
      "import": "./dist/sphere-gl.export.js",
      "default": "./src/export.js"
    },
    "./fallback": {
      "types": "./types/fallback.d.ts",
      "import": "./dist/sphere-gl.fallback.js",
      "default": "./src/fallback.js"
    },
    "./studio": {
      "types": "./types/studio.d.ts",
      "import": "./dist/sphere-gl.studio.js",
      "default": "./src/studio.js"
    },
    "./palettes": {
      "types": "./types/index.d.ts",
      "import": "./dist/sphere-gl.palettes.js",
      "default": "./src/palettes.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "sideEffects": [
    "./dist/sphere-gl.min.js",
    "./src/browser.js"
  ],
  "files": [
    "dist",
    "src",
    "types",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "webgl2",
    "glsl",
    "gradient",
    "mesh-gradient",
    "sphere-gradient",
    "oklch",
    "oklab",
    "display-p3",
    "background",
    "wallpaper",
    "solar-clock",
    "web-component",
    "framer",
    "react",
    "procedural",
    "shader"
  ],
  "author": "Denis S. (https://github.com/denissitnikov)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denissitnikov/sphere-gl.git"
  },
  "bugs": {
    "url": "https://github.com/denissitnikov/sphere-gl/issues"
  },
  "homepage": "https://denissitnikov.github.io/sphere-gl/"
}
